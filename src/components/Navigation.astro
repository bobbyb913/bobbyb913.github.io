---
import Stroop from "../components/Stroop-icon.astro";
import Book from "../components/Science-book-icon.astro";
---

<div class="navbar bg-primary mb-4">
    <div class="hover-art w-1/8 flex mr-4">
        <div class="my-auto">
            <a href="/stroop">
                <Stroop />
            </a>
        </div>
        <div class="my-auto">
            <a href="/science-exhibit">
                <Book />
            </a>
        </div>
    </div>
    <div>
        <a class="hover-art text-lg font-bold" href="/"></a>
    </div>
    <div class="md:ml-auto md:mr-0 mx-auto">
        <ul class="menu menu-horizontal menu-lg">
            <li><a class="btn btn-ghost" href="/">Home</a></li>
            <li class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="btn btn-ghost">
                    Projects
                </div>
                <ul
                    tabindex="-1"
                    class="dropdown-content bg-base-100 rounded-box z-1 w-52 p-2 shadow-sm"
                >
                    <li>
                        <a href="/science-exhibit">Science Exhibit Book</a>
                    </li>
                    <li><a href="/stroop">Stroop Says</a></li>
                </ul>
            </li>
            <li><a class="btn btn-ghost" href="/contact">Contact</a></li>
        </ul>
    </div>
</div>
