---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import profileImage from "../assets/images/profile.webp";
import stroopImage from "../assets/images/stroop.webp";
import bookImage from "../assets/images/visual-system.webp";
import tileImage from "../assets/images/tile_brainstorm.webp";
import lightboxImage from "../assets/images/lightbox_model.webp";
import y2kImage from "../assets/images/terminal_under_dev.webp";
import electronicsImage from "../assets/images/electronics.webp";
import Book from "../components/Science-book-icon-little.astro";

import "../styles/global.css";
const cardFormat = "card shadow-sm";
const cardFormatBody = "card-body";
const cardFormatButton = "btn btn-accent w-1/2 mx-auto";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Robert Bourque's Portfolio</title>
	</head>

	<body>
		<Navigation />

		<div class="mx-auto w-7/8 md:w-2/3 space-y-2">
			<div class="hero rounded-lg bg-base-200">
				<div
					class="hero-content md:flex grid md:grid-cols-2 grid-cols-1"
				>
					<img
						loading="lazy"
						alt="stripboards with wires, mechanical keys, lcd displays and esp32s"
						src={electronicsImage.src}
						class="md:max-w-sm rounded-lg shadow-2xl"
					/>
					<div class="">
						<h1 class="text-3xl font-bold pb-3">
							I make toys and games that explore science concepts.
						</h1>
						<p class="pb-3 text-xl">
							I like to combine education and interaction design
							with <span class="font-bold">electronics</span> and <span
								class="font-bold">physical fabrication</span
							>. I am fascinated by neuroscience, biology, and
							language.
						</p>
						<p class="pb-3 text-xl">
							I am hoping to apply the skills I have learned to
							work in science museums & makerspaces, where people <span
								class="font-bold">play</span
							> and <span class="font-bold">learn</span>.
						</p>
						<a
							href="/science-exhibit"
							class="text-lg science-book inline-flex btn btn-primary py-7"
						>
							Featured Project:<Book />
						</a>
					</div>
				</div>
			</div>
			<div class="divider"></div>
			<div>
				<h2 class="text-2xl font-bold text-center w-1/3 mx-auto">
					Projects
				</h2>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				<div class={cardFormat}>
					<figure>
						<img
							class="h-75 object-contain"
							loading="lazy"
							alt="diagram of the eye with moveable pieces"
							src={bookImage.src}
						/>
					</figure>
					<div class={cardFormatBody}>
						<h3 class="card-title text-xl font-bold">
							Science Exhibit In-A-Book
						</h3>
						<p>
							Portable exhibits on topics in biology and
							neuroscience.
						</p>
						<a class={cardFormatButton} href="/science-exhibit"
							>Learn more</a
						>
					</div>
				</div>
				<div class={cardFormat}>
					<figure>
						<img
							class="h-75 object-contain"
							loading="lazy"
							alt="a handheld game with four buttons and a screen in the middle"
							src={stroopImage.src}
						/>
					</figure>
					<div class={cardFormatBody}>
						<h3 class="card-title text-xl font-bold">
							Stroop Says
						</h3>
						<p>A twist on the classic children's toy.</p>
						<a class={cardFormatButton} href="/stroop">Learn more</a
						>
					</div>
				</div>
				<div class={cardFormat}>
					<figure>
						<img
							class="h-75 object-contain"
							loading="lazy"
							alt="three tiles, representing carbon, nitrogen, and oxygen have blue dots representing unpaired electrons and strips of yellow representing a bond"
							src={tileImage.src}
						/>
					</figure>
					<div class={cardFormatBody}>
						<h3 class="card-title text-xl font-bold">
							Octet Rule Tiles
						</h3>
						<p>
							UNDER DEVELOPMENT. An alternative molecular modeling
							kit.
						</p>
						<a class={cardFormatButton} href="/octet">See preview</a
						>
					</div>
				</div>

				<div class={cardFormat}>
					<figure>
						<img
							class="h-75 object-contain"
							loading="lazy"
							alt="model of a console with an angled surface with a hole in the middle and an arm extending up for a camera"
							src={lightboxImage.src}
						/>
					</figure>
					<div class={cardFormatBody}>
						<h3 class="card-title text-xl font-bold">
							Contrasting Color Lightbox
						</h3>
						<p>
							UNDER DEVELOPMENT. Draw short animations with
							flashing lights.
						</p>
						<a class={cardFormatButton} href="/lightbox"
							>See preview</a
						>
					</div>
				</div>

				<div class={cardFormat}>
					<figure>
						<img
							class="h-75 object-contain"
							loading="lazy"
							alt="a console made out of wood with an LCD display with a date and two buttons, unfinished"
							src={y2kImage.src}
						/>
					</figure>
					<div class={cardFormatBody}>
						<h3 class="card-title text-xl font-bold">
							Y2K Escape Room
						</h3>
						<p>
							UNDER DEVELOPMENT. Race against the clock to save
							the world from Y2K!
						</p>
						<a class={cardFormatButton} href="/y2k">See preview</a>
					</div>
				</div>
			</div>
			<div class="divider"></div>
			<div>
				<h2 class="text-2xl font-bold text-center w-1/3 mx-auto">
					About
				</h2>
				<div class="grid md:grid-cols-3 grid-cols-1 gap-4">
					<img
						loading="lazy"
						alt="Bobby smiles in front of a Venetian canal"
						src={profileImage.src}
						class="rounded-box"
					/>
					<div class="space-y-4 md:col-span-2 my-auto text-lg">
						<p>
							Hello! My name is Bobby. I'm a graduate student at
							CU Boulder at the ATLAS Institute working towards my
							master’s degree in Creative Technology and Design.
						</p>
						<p>
							I'm originally from outside of Boston. I graduated
							from Wesleyan University with a double major in
							Neuroscience and Italian.
						</p>
						<p>
							In my free time you can find me running, doing
							crosswords, and baking.
						</p>
					</div>
				</div>
			</div>
		</div>
		<Footer />
	</body>
</html>
