---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import profileImage from "../assets/images/profile.webp";
import stroopImage from "../assets/images/stroop.webp";
import bookImage from "../assets/images/visual-system.webp";
import electronicsImage from "../assets/images/electronics.webp";
import Book from "../components/Science-book-icon-little.astro";

import "../styles/global.css";
const cardFormat = "card shadow-sm";
const cardFormatBody = "card-body";
const cardFormatButton = "btn btn-accent w-1/2 mx-auto";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Home Page</title>
	</head>

	<body>
		<Navigation />

		<div class="mx-auto w-7/8 md:w-2/3 space-y-2">
			<div class="hero rounded-lg bg-base-200">
				<div
					class="hero-content md:flex grid md:grid-cols-2 grid-cols-1"
				>
					<img
						loading="lazy"
						alt="stripboards with wires, mechanical keys, lcd displays and esp32s"
						src={electronicsImage.src}
						class="md:max-w-sm rounded-lg shadow-2xl"
					/>
					<div class="">
						<h1 class="text-3xl font-bold">
							I make toys and games that explore science concepts.
						</h1>
						<p class="py-6 text-xl">
							I like to combine education and interaction design
							with electronics and physical fabrication. Thanks to
							my background in neuroscience and biology, my
							projects are inspired by the natural world.
						</p>
						<a
							href="/science-exhibit"
							class="text-lg science-book inline-flex btn btn-primary py-7"
						>
							Featured Project:<Book />
						</a>
					</div>
				</div>
			</div>
			<div class="divider"></div>
			<div>
				<h2 class="text-2xl font-bold text-center w-1/3 mx-auto">
					Projects
				</h2>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				<div class={cardFormat}>
					<figure>
						<img
							loading="lazy"
							alt="diagram of the eye with moveable pieces"
							src={bookImage.src}
						/>
					</figure>
					<div class={cardFormatBody}>
						<h3 class="card-title text-xl font-bold">
							Science Exhibit In-A-Book
						</h3>
						<p>
							Portable exhibits on topics in biology and
							neuroscience.
						</p>
						<a class={cardFormatButton} href="/science-exhibit"
							>Learn more</a
						>
					</div>
				</div>
				<div class={cardFormat}>
					<figure>
						<img
							loading="lazy"
							alt="a handheld game with four buttons and a screen in the middle"
							src={stroopImage.src}
						/>
					</figure>
					<div class={cardFormatBody}>
						<h3 class="card-title text-xl font-bold">
							Stroop Says
						</h3>
						<p>A twist on the classic children's toy.</p>
						<a class={cardFormatButton} href="/stroop">Learn more</a
						>
					</div>
				</div>
				
			</div>
			<div class="divider"></div>
			<div>
				<h2 class="text-2xl font-bold text-center w-1/3 mx-auto">
					About
				</h2>
				<div class="grid md:grid-cols-3 grid-cols-1 gap-4">
					<img
						loading="lazy"
						alt="Bobby smiles in front of a Venetian canal"
						src={profileImage.src}
						class="rounded-box"
					/>
					<div class="space-y-4 md:col-span-2 my-auto text-lg">
						<p>
							Hello! My name is Bobby. I am a graduate student at
							CU Boulder at the ATLAS Institute working towards my
							master’s degree in Creative Technology and Design.
						</p>
						<p>
							I am originally from outside of Boston, MA. I
							graduated from Wesleyan University with a double
							major in Neuroscience and Italian (and became a
							science and language nerd).
						</p>
						<p>
							In my free time you can find me running, doing
							crosswords, and baking.
						</p>
					</div>
				</div>
			</div>
		</div>
		<Footer />
	</body>
</html>
